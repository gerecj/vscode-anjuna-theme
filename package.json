{
  "name": "anjuna-theme",
  "displayName": "Anjuna Theme",
  "description": "A darker take on VS Code's Dark Modern theme",
  "version": "0.1.0",
  "publisher": "gerecj",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#191919",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gerecj/vscode-anjuna-theme.git"
  },
  "bugs": {
    "url": "https://github.com/gerecj/vscode-anjuna-theme/issues"
  },
  "homepage": "https://github.com/gerecj/vscode-anjuna-theme#readme",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark",
    "dark modern",
    "minimal"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.experimental.modernUIEditorTabStyle": "pill"
    },
    "themes": [
      {
        "label": "Anjuna",
        "uiTheme": "vs-dark",
        "path": "./themes/anjuna-color-theme.json"
      }
    ]
  }
}
